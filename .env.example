# Copy to .env and adjust. Never commit the real .env.

# Static admin token (alternative to JWT login)
KEYCHECK_ADMIN_TOKEN=dev-secret-change-me

# JWT login credentials
KEYCHECK_ADMIN_USER=admin
KEYCHECK_ADMIN_PASSWORD=admin

# JWT signing — MUST be >= 32 chars in production
KEYCHECK_JWT_SECRET=dev-secret-jwt-change-me-please-123
KEYCHECK_JWT_EXPIRES_MINUTES=60
