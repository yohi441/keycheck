# Copy to .env and adjust. Never commit the real .env.

KEYCHECK_ENV=development

# Static admin token (alternative to JWT login)
KEYCHECK_ADMIN_TOKEN=dev-secret-change-me

# JWT login credentials
KEYCHECK_ADMIN_USER=admin
KEYCHECK_ADMIN_PASSWORD=admin

# JWT signing — MUST be >= 32 chars in production
KEYCHECK_JWT_SECRET=dev-secret-jwt-change-me-please-123
KEYCHECK_JWT_EXPIRES_MINUTES=60

# --- Signed, machine-bound product keys ---------------------------------
# The Ed25519 private seed used to sign CLN1- keys. 64 hex characters.
# This is the SAME seed as %LOCALAPPDATA%\ClinicManager-keys\vendor.key on the
# vendor machine. NEVER commit the real value.
#
# Lose it -> no further keys can be issued for the current app build.
# Leak it  -> anyone can mint keys the app will accept.
#
# If unset, /api/keys/sign returns 503 and everything else keeps working.
# KEYCHECK_LICENSE_SEED=

# Optional: pin the public key the app was built with. When set, /api/keys/sign
# refuses to issue a key that does not verify against it, catching a seed that
# disagrees with the shipped app at issue time instead of at the customer's
# machine. Leave blank to derive it from the seed.
# KEYCHECK_LICENSE_PUBLIC_KEY=
